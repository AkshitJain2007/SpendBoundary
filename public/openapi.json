{
  "openapi": "3.1.0",
  "info": {
    "title": "SpendBoundary AI Commerce API",
    "description": "Policy-gated payment gateway and execution firewall for autonomous AI agents.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://spendboundary.vercel.app"
    }
  ],
  "paths": {
    "/api/catalogue": {
      "get": {
        "operationId": "searchCatalogue",
        "summary": "Search products in the merchant catalogue",
        "description": "Returns inventory products with prices in integer paise, category, stock, and allow/block status.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search keyword or category"
          }
        ],
        "responses": {
          "200": {
            "description": "Catalogue response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "pricePaise": {
                            "type": "integer"
                          },
                          "priceRupees": {
                            "type": "number"
                          },
                          "stock": {
                            "type": "integer"
                          },
                          "allowed": {
                            "type": "boolean"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/policy": {
      "get": {
        "operationId": "getPolicyLimits",
        "summary": "Get merchant spending policies and card mandate status",
        "description": "Returns single-order cap, 24h spend limit, approval threshold, allowed categories, and tokenized card mandate status.",
        "responses": {
          "200": {
            "description": "Policy details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policy": {
                      "type": "object"
                    },
                    "paymentMandate": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "operationId": "requestCheckout",
        "summary": "Submit cart for policy evaluation and payment execution",
        "description": "Evaluates cart against merchant limits. If ALLOW (< ₹1,000), completes payment autonomously without OTP. If REVIEW (> ₹1,000), returns a hosted Razorpay payment link.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items",
                  "reason"
                ],
                "properties": {
                  "agentId": {
                    "type": "string",
                    "default": "chatgpt_user"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "productId",
                        "quantity"
                      ],
                      "properties": {
                        "productId": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "default": 1
                        }
                      }
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout decision and payment result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "type": "string",
                      "enum": [
                        "ALLOW",
                        "REVIEW",
                        "DENY"
                      ]
                    },
                    "status": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "totalRupees": {
                      "type": "number"
                    },
                    "paymentLinkUrl": {
                      "type": "string",
                      "nullable": true
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/approvals": {
      "get": {
        "operationId": "checkApprovalStatus",
        "summary": "Check approval and payment status of a checkout request",
        "description": "Returns status of pending review orders with live Razorpay payment reconciliation.",
        "responses": {
          "200": {
            "description": "Approvals list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approvals": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}